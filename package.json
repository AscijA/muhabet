{
  "name": "muhabet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-loader-spinner": "^8.0.2",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.3",
    "sass": "^1.104.1",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src e2e --ext .ts,.tsx,.js",
    "check": "npm run typecheck && npm run functions:build && npm run lint && npm run test:unit && npm run test:rules && npm run test:e2e && npm run build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --project muhabet-rules-test --only firestore \"vitest run src/infrastructure/firebase/firestore.rules.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "functions:build": "tsc -p functions/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "firebase-tools": "^15.30.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
