rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(chat) {
      return signedIn() && request.auth.uid in chat.participantIDs;
    }

    function parentChat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    match /users/{userId} {
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
    }

    match /user-directory/{emailHash} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.participantIDs is list
        && request.auth.uid in request.resource.data.participantIDs
        && request.resource.data.participantIDs.size() == 2;
      allow read: if isParticipant(resource.data);
      allow update: if isParticipant(resource.data)
        && request.resource.data.participantIDs == resource.data.participantIDs;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(parentChat(chatId));
        allow create: if isParticipant(parentChat(chatId))
          && request.resource.data.ownerID == request.auth.uid
          && request.resource.data.messageID == messageId;
        allow update: if isParticipant(parentChat(chatId))
          && request.resource.data.ownerID == resource.data.ownerID
          && (
            resource.data.ownerID == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messageStatus'])
          );
        allow delete: if false;
      }
    }
  }
}
